{
  "name": "@concord/console",
  "version": "0.1.0",
  "private": true,
  "description": "Reviewer console: the approval queue, the evidence behind each decision, and the run trace.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "biome check .",
    "format": "biome check --write .",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run types && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  }
}
