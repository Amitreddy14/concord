# Copy to .env and adjust. Never commit .env.

# --- Deployment identity -----------------------------------------------------
CONCORD_ENV=local
CONCORD_TENANT=acme-payments          # selects infra/tenants/<tenant>.yaml

# --- Inference ---------------------------------------------------------------
# The LLM gateway speaks the OpenAI-compatible protocol. Ollama runs on the host
# so the GPU is reachable without container passthrough.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=not-needed-for-local
LLM_MODEL_PRIMARY=qwen3:8b            # resolution, extraction, drafting
LLM_MODEL_TRIAGE=qwen3:8b             # same resident model by default; see ADR 0003
LLM_EMBEDDING_MODEL=nomic-embed-text
LLM_KEEP_ALIVE=30m                    # avoid VRAM reload thrash between runs
LLM_MAX_CONTEXT_TOKENS=8192
LLM_NODE_CONTEXT_BUDGET=2048          # per-node ceiling, enforced in code
LLM_TEMPERATURE=0
LLM_SEED=11

# --- Persistence -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=concord
POSTGRES_USER=concord
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://concord:change-me@localhost:5432/concord

# --- Systems of record (mocks in local development) --------------------------
CRM_BASE_URL=http://localhost:8101
PAYMENTS_BASE_URL=http://localhost:8102
TICKETING_BASE_URL=http://localhost:8103
KNOWLEDGE_BASE_URL=http://localhost:8104

# --- Fault injection (phase 1) ----------------------------------------------
# off | flaky | hostile. Applied by the mock services' middleware.
FAULT_PROFILE=off
FAULT_SEED=1337

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=concord-api
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Console -----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
